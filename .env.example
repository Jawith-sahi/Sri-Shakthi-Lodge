# ---------------------------------------------------------------
# Sri Sakthi Lodge - environment variables
# Copy to .env.local (development) or set in your host (production).
# NEVER put secrets in NEXT_PUBLIC_* variables: they are shipped to browsers.
# ---------------------------------------------------------------

# Base URL of the ASP.NET Core Web API (no trailing slash), e.g. https://api.srisakthilodge.example
NEXT_PUBLIC_API_BASE_URL=

# DEV ONLY. "true" serves clearly-labelled sample data and a mock payment adapter.
# The app refuses to start/build in production while this is "true".
NEXT_PUBLIC_USE_MOCK=false

# Public site URL (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay PUBLIC key id only (rzp_test_... / rzp_live_...). The key SECRET lives only in the .NET backend.
# The backend may also return the key id with the payment order; the order value wins.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# WhatsApp number in international format, digits only (e.g. 917200074204). Leave empty to hide WhatsApp buttons.
# TODO(verify): confirm with the client which number is used for WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: extra hosts (comma separated) that next/image may optimise, e.g. a CDN for uploaded photos.
NEXT_PUBLIC_IMAGE_HOSTS=

# Optional: Cloudflare Turnstile site key (public). Leave empty to disable the captcha hook.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ----- Server-only variables (NOT exposed to the browser) -----

# Shared secret that lets the .NET backend call POST /api/revalidate after content changes.
REVALIDATE_SECRET=
